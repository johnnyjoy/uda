{
    "connections": {
        "main_pg": {
            "driver": "pgsql",
            "params": {
                "host": "db1.internal",
                "port": 5432,
                "dbname": "app",
                "sslmode": "require"
            },
            "user": {
                "env": "PG_USER"
            },
            "pass": {
                "env": "PG_PASS"
            }
        },
        "audit_sqlite": {
            "driver": "sqlite",
            "params": {
                "path": ":memory:"
            },
            "user": null,
            "pass": null
        },
        "client_0123": {
            "driver": "sqlserver",
            "transport": "sqlsrv",
            "params": {
                "host": "sql01.internal",
                "port": 1433,
                "database": "Client0123"
            },
            "user": {
                "env": "SQL_USER"
            },
            "pass": {
                "env": "SQL_PASS"
            }
        },
        "legacy_ase_dblib": {
            "driver": "dblib",
            "params": {
                "host": "ase.internal",
                "dbname": "legacy"
            },
            "user": {
                "env": "ASE_USER"
            },
            "pass": {
                "env": "ASE_PASS"
            }
        },
        "mssql_over_dblib": {
            "driver": "sqlserver",
            "transport": "dblib",
            "params": {
                "host": "mssql.internal",
                "dbname": "app"
            },
            "user": {
                "env": "SQL_USER"
            },
            "pass": {
                "env": "SQL_PASS"
            }
