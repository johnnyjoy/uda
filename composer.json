{
    "name": "universal-data-abstraction/universal-data-abstraction",
    "description": "A comprehensive PHP 8.2+ Universal Data Abstraction System",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Universal Data Abstraction Team",
            "email": "team@universaldataabstraction.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.0",
        "symfony/finder": "^6.0",
        "friendsofphp/php-cs-fixer": "^3.94"
    },
    "autoload": {
        "psr-4": {
            "UDA\\": "src/UDA/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UniversalDataAbstraction\\Tests\\": "tests/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:sybase-live": "UDA_SYBASE_LIVE=1 vendor/bin/phpunit --bootstrap tests/sybase-bootstrap.php tests/Sybase",
        "stan": "vendor/bin/phpstan analyse src/",
        "check": [
            "@php tools/check-purpose.php",
            "@php tools/check-license.php",
            "@php tools/check-pdo-usage.php",
            "@php tools/check-execution-path.php",
            "@php tools/check-imports.php",
            "@php tools/check-forbidden-names.php"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
