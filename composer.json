{
    "name": "universal-data-abstraction/universal-data-abstraction",
    "description": "A comprehensive PHP 8.2+ Universal Data Abstraction System",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Universal Data Abstraction Team",
            "email": "team@universaldataabstraction.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "UDA\\": "src/UDA/",
            "UDA\\SQL\\": "src/SQL/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UniversalDataAbstraction\\Tests\\": "tests/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse src/",
        "check": [
            "@php tools/check-license.php"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
