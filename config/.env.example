# Database Configuration
# Copy this file to .env and update the values as needed

# Default database driver
DB_DEFAULT=mysql

# MySQL Configuration
DB_MYSQL_HOST=localhost
DB_MYSQL_PORT=3306
DB_MYSQL_DATABASE=myapp
DB_MYSQL_USERNAME=root
DB_MYSQL_PASSWORD=
DB_MYSQL_CHARSET=utf8mb4
DB_MYSQL_COLLATION=utf8mb4_unicode_ci
DB_MYSQL_PREFIX=

# PostgreSQL Configuration
DB_PGSQL_HOST=localhost
DB_PGSQL_PORT=5432
DB_PGSQL_DATABASE=myapp
DB_PGSQL_USERNAME=root
DB_PGSQL_PASSWORD=
DB_PGSQL_CHARSET=utf8
DB_PGSQL_PREFIX=

# SQLite Configuration
DB_SQLITE_DATABASE=database.sqlite

# SQL Server Configuration
DB_SQLSRV_SERVER=localhost
DB_SQLSRV_DATABASE=myapp
DB_SQLSRV_USERNAME=root
DB_SQLSRV_PASSWORD=
DB_SQLSRV_CHARSET=utf8

# Oracle Configuration
DB_OCI_HOST=localhost
DB_OCI_PORT=1521
DB_OCI_DATABASE=myapp
DB_OCI_USERNAME=root
DB_OCI_PASSWORD=
DB_OCI_CHARSET=AL32UTF8